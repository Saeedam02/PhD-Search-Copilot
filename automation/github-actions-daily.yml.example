# Copy this file to .github/workflows/daily-agent.yml only if you intentionally
# want GitHub Actions to run the agent on a schedule and have configured the
# OPENAI_API_KEY repository secret. A GitHub-hosted runner has no access to your
# local workspace unless you securely provision it.
name: Daily PhD agent

on:
  workflow_dispatch:
  schedule:
    - cron: "0 7 * * *"

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: "3.13"
      - run: python -m pip install -e .
      - run: phd-agent run-cycle
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
