# Required for live AI-agent runs.
OPENAI_API_KEY=sk-...

# Override if you want to use another Responses-compatible OpenAI model.
OPENAI_MODEL=gpt-5.6-sol

# Optional. Set to 1 if you do not want OpenAI Agents SDK tracing.
OPENAI_AGENTS_DISABLE_TRACING=0

# Optional SMTP dispatch. The repository never sends mail without an explicit
# approved dispatch command. Leave these empty if you only want draft files.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
